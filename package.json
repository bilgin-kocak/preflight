{
  "name": "preflight-celo-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "register:identity": "node --env-file-if-exists=.env --import tsx scripts/register-identity.ts",
    "review:prepare": "node --env-file-if-exists=.env --import tsx scripts/prepare-review.ts",
    "smoke:live": "node --env-file-if-exists=.env --import tsx scripts/smoke-live.ts"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.3.0",
    "@hono/node-server": "^2.1.1",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/hono": "^2.25.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.7",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
